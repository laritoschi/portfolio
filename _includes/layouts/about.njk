---
layout: layouts/base.njk
header: about

copyButtons:
  - email
  - phone

linkButtons:
  - linkedin
---

<section class="about-hero">
  <div class="about-intro">
    <h5>{{ 'about.hero.eyebrow' | t }}</h5>
    <h2 class="intro-title1">{{ 'about.hero.title1' | t }}</h2> 
    <h1 class="intro-title2">{{ 'about.hero.title2' | t }}</h1>
    <p class="intro-text">{{ 'about.hero.text' | t }}</p>

    <span class="intro-pill">
      <div class="ring-container">
        <div class="ringring"></div>
        <div class="circle"></div>
      </div>
      {{ 'about.hero.available' | t }}
    </span>

    <div class="intro-buttons">
      <a class="btn secondary" target="_blank" href="{{ cv }}">
        <span class="icon">download</span> {{ 'about.hero.cv' | t }}
      </a>

      <a class="btn secondary" target="_blank" href="{{ metadata.linkedin }}">
        <span class="icon">open_in_new</span> {{ 'about.hero.linkedin' | t }}
      </a>
    </div>
  </div>

  <div class="profile-card">
    <h3>{{ 'about.profile.title' | t }}</h3>
    <br />

    <span class="icon-label">
      <span>location_on</span> {{ 'about.profile.location' | t }}
    </span>
    <br />

    <span class="icon-label">
      <span>public</span> {{ 'about.profile.remote' | t }}
    </span>
    <br />

    <span class="icon-label">
      <h7>{{ 'about.profile.social' | t }}</h7>

      <a href="{{ metadata.linkedin }}" target="_blank"><img alt="LinkedIn" src="/assets/icons/linkedin.svg" /></a>
      <a href="mailto:{{ metadata.email }}" target="_blank"><img alt="E-mail" src="/assets/icons/email.svg" /></a>
      <a href="{{ metadata.whatsapp }}" target="_blank"><img alt="WhatsApp" src="/assets/icons/whatsapp.svg" /></a>
    </span>
  </div>
</section>

<section class="about-content">
  {{ content | section('beforeContact') | safe }}

  <div class="contact-card">
    {% for btn in copyButtons %}
      <div class="contact-row">
        <h7>{{ ['about.contact.', btn] | join | t }}</h7>
        <p>{{ metadata[btn] }}</p>
        <button class="contact-button" data-copy-value="{{ metadata[btn] }}">content_copy</button>
      </div>
    {% endfor %}

    {% for btn in linkButtons %}
      <div class="contact-row">
        <h7>{{ ['about.contact.', btn] | join | t }}</h7>
        <p>{{ metadata[btn] }}</p>
        <a class="contact-button" href="{{ metadata[btn] }}" target="_blank">open_in_new</a>
      </div>
    {% endfor %}
  </div>

  {{ content | section('afterContact') | safe }}

  <br />
  <a class="btn secondary" target="_blank" href="{{ metadata.linkedin }}">
    <span class="icon">open_in_new</span> {{ 'about.cv.linkedin' | t }}
  </a>
</section>

<script src="/assets/scripts/copy.js"></script>